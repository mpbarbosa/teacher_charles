# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Ambiente local
.env

# Pesos de modelo nunca entram no repo (ficam em ~/.ollama)
models/
*.gguf
*.bin
*.safetensors

# Dados do aluno nunca entram no repo (ficam em XDG_DATA_HOME)
*.db
*.db-wal
*.db-shm

# Gravacoes de voz nunca entram no repo. Mesma razao do *.db: e dado pessoal.
# O measure_phonemes escreve o WAV e o relatorio .json lado a lado em
# gravacoes/, e o relatorio e dado pessoal tambem -- carrega a transcricao do
# que a pessoa disse. O *.wav solto cobre gravacao feita fora da pasta.
gravacoes/
*.wav

# Preferencia de quem desenvolve, nao configuracao do projeto. O
# .claude/launch.json ao lado e rastreado de proposito: ele diz como subir o
# servidor, e isso vale para quem clonar. O settings.json guarda a escolha de
# modelo de quem esta na maquina, que nao vale para os outros.
.claude/settings.json
