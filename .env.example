# Copie para .env e ajuste. Todas as variaveis sao opcionais:
# os defaults abaixo sao os mesmos de src/teacher_charles/config.py.

# --- Modelo ---------------------------------------------------------------
# Provider: "ollama" (local, default), "openai_compat" (nuvem, opcional)
# ou "fake" (sem modelo nenhum, para trabalhar na interface).
TC_PROVIDER=ollama

# Modelo default da Fase 1: um 4B-class quantizado.
# Medido nesta maquina em CPU pura: 9,3 tok/s num 3B e 4,0 num 7B, o que poe um
# 4B em ~7-8 tok/s; 14B fica inviavel. (Os "20-25 tok/s" que este comentario
# dizia antes eram estimativa, e a E1 mediu que estava 2,5x otimista --
# ver docs/plano-fase-1.md 1.3.)
TC_LLM_MODEL=qwen3:4b

# Com graficos Intel integrados, subir o Ollama com OLLAMA_VULKAN=1 e
# OLLAMA_IGPU_ENABLE=1 deixa a avaliacao de prompt 13x mais rapida -- e e ela
# que domina a espera pela primeira palavra (7,4s -> 0,9s). A geracao quase nao
# muda: empata num 3B, ganha 1,5x num 7B. Ver docs/plano-fase-1-5.md 7. Se o
# servidor da iGPU estiver noutra porta, aponte TC_OLLAMA_URL para ela.
TC_OLLAMA_URL=http://localhost:11434
TC_REQUEST_TIMEOUT_S=120

# Modelos de raciocinio (Qwen3 entre eles) pensam antes de responder, e isso
# custa segundos que uma conversa nao tem. Vazio = default do servidor.
# Ponha false para desligar e ganhar latencia.
# TC_LLM_THINK=false

# Aquece o modelo na subida, mandando a persona, para o primeiro turno nao
# pagar a carga do modelo nem a avaliacao do prompt (medido: 19s -> 7s).
TC_LLM_WARMUP=true

# --- Voz (Fase 1.5) -------------------------------------------------------
# Desligada por default: o chat por texto funciona inteiro sem ela, e ligar
# carrega dois runtimes nativos (ctranslate2 e onnxruntime) no processo.
# Precisa de `uv sync --extra voice` e dos pesos:
#   uv run python scripts/fetch_voice_models.py
TC_VOICE_ENABLED=false

# base.en, e nao small.en: medido nesta maquina, o small.en leva 2,4s numa
# fala curta e fura sozinho o orcamento do turno; o base.en leva 0,91s.
# Ver docs/plano-fase-1-5.md 2.2.
TC_STT_MODEL=base.en
TC_STT_COMPUTE_TYPE=int8
TC_STT_BEAM_SIZE=1

# O default do ctranslate2 deixa ~30% na mesa; 14 piora (hyperthreads).
TC_STT_CPU_THREADS=8

# Kokoro-82M em ONNX. O int8 e mais rapido E 3,5x menor que o fp32.
TC_TTS_MODEL=kokoro-v1.0.int8.onnx

# Charles e um professor, e um professor tem uma voz. bm_george e a masculina
# britanica; o arquivo traz 54, e o /health lista quantas carregaram.
TC_TTS_VOICE=bm_george
TC_TTS_SPEED=1.0

# 0 = nao mexa. Aqui limitar PIORA, ao contrario do STT.
TC_TTS_CPU_THREADS=0

# Default: $XDG_CACHE_HOME/teacher-charles/voice. E cache, nao dado do aluno.
# TC_VOICE_DIR=

# --- Nuvem opcional (so com TC_PROVIDER=openai_compat) --------------------
# TC_OPENAI_BASE_URL=https://api.openai.com/v1
# TC_OPENAI_API_KEY=

# --- Servidor -------------------------------------------------------------
TC_HOST=127.0.0.1
TC_PORT=8000

# --- Caminhos -------------------------------------------------------------
# Default: $XDG_DATA_HOME/teacher-charles/charles.db
# TC_DB_PATH=
