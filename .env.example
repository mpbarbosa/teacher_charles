# Copie para .env e ajuste. Todas as variaveis sao opcionais:
# os defaults abaixo sao os mesmos de src/teacher_charles/config.py.

# --- Modelo ---------------------------------------------------------------
# Provider: "ollama" (local, default), "openai_compat" (nuvem, opcional)
# ou "fake" (sem modelo nenhum, para trabalhar na interface).
TC_PROVIDER=ollama

# Modelo default: um 3B quantizado, por medicao.
# Medido nesta maquina em CPU pura: 9,3 tok/s num 3B e 4,0 num 7B; 14B fica
# inviavel. (Os "20-25 tok/s" que este comentario dizia antes eram estimativa,
# e a E1 mediu que estava 2,5x otimista -- ver docs/plano-fase-1.md 1.3.)
# O 4B (qwen3:4b-instruct) gera a ~55% da vazao do 3B, empata com ele na
# correcao estruturada e, medido as cegas, empata tambem na prosa do professor
# -- e pela regra do plano, empate da o 3B (5.5).
#
# Se voltar ao 4B, mantenha o sufixo -instruct: `qwen3:4b` sozinho e o build
# Thinking, que raciocina antes de toda resposta e nao deixa desligar (5.5).
TC_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

# Com graficos Intel integrados, subir o Ollama com OLLAMA_VULKAN=1 e
# OLLAMA_IGPU_ENABLE=1 deixa a avaliacao de prompt 13x mais rapida -- e e ela
# que domina a espera pela primeira palavra (7,4s -> 0,9s). A geracao quase nao
# muda: empata num 3B, ganha 1,5x num 7B. Ver docs/plano-fase-1-5.md 7. Se o
# servidor da iGPU estiver noutra porta, aponte TC_OLLAMA_URL para ela.
TC_OLLAMA_URL=http://localhost:11434
TC_REQUEST_TIMEOUT_S=120

# Modelos de raciocinio (Qwen3 entre eles) pensam antes de responder, e isso
# custa segundos que uma conversa nao tem. Vazio = default do servidor.
#
# false PEDE para desligar, e so desliga num modelo cujo template le o pedido
# (`ollama show --template <modelo>` mostra `.Think`; o template do qwen3:8b
# le). O qwen3:4b sem sufixo NAO e um deles: a tag e o
# Qwen3-4B-Thinking-2507, que raciocina sempre. Medido no Ollama 0.35, numa
# resposta de uma palavra: 179 tokens com false, 247 com true, 280 sem o
# campo -- false nao ganhou latencia nenhuma, e fez o raciocinio inteiro sair
# dentro da resposta que o aluno le.
#
# Por isso o app so manda `think: false` ao Ollama quando o template o le. Nos
# outros modelos o campo nao vai, o servidor separa o raciocinio e ele nunca
# chega a tela -- mas continua acontecendo, e a espera pela primeira palavra o
# inclui (o log avisa quando o template abre o <think> sozinho). Para nao pagar
# por ele, o caminho e um modelo que nao raciocina, como o qwen2.5 3B do
# default ou o qwen3:4b-instruct: neles o campo nao tem o que desligar
# (medido no 4B: a mesma resposta de 2 tokens com false e sem o campo).
# TC_LLM_THINK=false

# Aquece o modelo na subida, mandando a persona, para o primeiro turno nao
# pagar a carga do modelo nem a avaliacao do prompt (medido: 19s -> 7s).
TC_LLM_WARMUP=true

# O botão Structure embaixo de cada fala: a sentença dividida em sujeito,
# verbo, objetos e sintagmas por um parser (spaCy), nunca pelo modelo.
# Desligado por default porque pede um extra de ~267 MB:
#   uv sync --extra dev --extra syntax
# Ligado sem o extra, o botão não aparece e o /health diz por quê.
TC_SYNTAX_ENABLED=false
# O pipeline do spaCy, pelo nome do pacote. O extra instala o pequeno.
# TC_SYNTAX_MODEL=en_core_web_sm

# --- Voz (Fase 1.5) -------------------------------------------------------
# Desligada por default: o chat por texto funciona inteiro sem ela, e ligar
# carrega dois runtimes nativos (ctranslate2 e onnxruntime) no processo.
# Precisa de `uv sync --extra voice` e dos pesos:
#   uv run python scripts/fetch_voice_models.py
TC_VOICE_ENABLED=false

# base.en, e nao small.en: medido nesta maquina, o small.en leva 2,4s numa
# fala curta e fura sozinho o orcamento do turno; o base.en leva 0,91s.
# Ver docs/plano-fase-1-5.md 2.2.
TC_STT_MODEL=base.en
# O Whisper que mede quando cada palavra da leitura da licao comeca. tiny.en:
# base.en junto com a sintese passava do tempo real e a leitura engasgava.
TC_STT_TIMING_MODEL=tiny.en
TC_STT_COMPUTE_TYPE=int8
TC_STT_BEAM_SIZE=1

# O default do ctranslate2 deixa ~30% na mesa; 14 piora (hyperthreads).
TC_STT_CPU_THREADS=8

# Kokoro-82M em ONNX. O int8 e mais rapido E 3,5x menor que o fp32.
TC_TTS_MODEL=kokoro-v1.0.int8.onnx

# Charles e um professor, e um professor tem uma voz. bm_george e a masculina
# britanica; o arquivo traz 54, e o /health lista quantas carregaram.
TC_TTS_VOICE=bm_george
# Quem le em voz alta o texto completo de uma licao: bf_emma, a feminina
# britanica. Uma voz que nao e a do Charles, porque o texto nao e dele.
TC_TTS_READER_VOICE=bf_emma
TC_TTS_SPEED=1.0

# 0 = nao mexa. Aqui limitar PIORA, ao contrario do STT.
TC_TTS_CPU_THREADS=0

# Default: $XDG_CACHE_HOME/teacher-charles/voice. E cache, nao dado do aluno.
# TC_VOICE_DIR=

# --- Nuvem opcional (so com TC_PROVIDER=openai_compat) --------------------
# TC_OPENAI_BASE_URL=https://api.openai.com/v1
# TC_OPENAI_API_KEY=

# --- Servidor -------------------------------------------------------------
TC_HOST=127.0.0.1
TC_PORT=8000

# --- Caminhos -------------------------------------------------------------
# Default: $XDG_DATA_HOME/teacher-charles/charles.db
# TC_DB_PATH=
