# Copie para .env e ajuste. Todas as variaveis sao opcionais:
# os defaults abaixo sao os mesmos de src/teacher_charles/config.py.

# --- Modelo ---------------------------------------------------------------
# Provider: "ollama" (local, default) ou "openai_compat" (nuvem, opcional).
TC_PROVIDER=ollama

# Modelo default da Fase 1: um 4B-class quantizado.
# Nesta maquina (CPU/iGPU) 4B roda a ~20-25 tok/s; 14B fica inviavel.
TC_LLM_MODEL=qwen3:4b

TC_OLLAMA_URL=http://localhost:11434
TC_REQUEST_TIMEOUT_S=120

# --- Nuvem opcional (so com TC_PROVIDER=openai_compat) --------------------
# TC_OPENAI_BASE_URL=https://api.openai.com/v1
# TC_OPENAI_API_KEY=

# --- Servidor -------------------------------------------------------------
TC_HOST=127.0.0.1
TC_PORT=8000

# --- Caminhos -------------------------------------------------------------
# Default: $XDG_DATA_HOME/teacher-charles/charles.db
# TC_DB_PATH=
