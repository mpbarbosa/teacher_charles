{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "teacher-charles",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "teacher-charles",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "teacher-charles-voice",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "TC_VOICE_ENABLED=true uv run teacher-charles --port 8010"
      ],
      "port": 8010
    }
  ]
}
