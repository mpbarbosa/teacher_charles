{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "teacher-charles",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "teacher-charles",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "teacher-charles-voice",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "TC_VOICE_ENABLED=true uv run teacher-charles --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "teacher-charles-syntax",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "TC_PROVIDER=fake TC_SYNTAX_ENABLED=true TC_DB_PATH=${TMPDIR:-/tmp}/teacher-charles-preview.db uv run --extra dev --extra syntax teacher-charles --port 8020"
      ],
      "port": 8020
    }
  ]
}
